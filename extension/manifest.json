{
  "manifest_version": 2,
  "name": "Claude Code Bridge for Firefox",
  "version": "0.3.0",
  "description": "Lets Claude Code drive this Firefox through a local MCP bridge.",
  "homepage_url": "https://github.com/llyfn/claude-in-firefox",
  "browser_specific_settings": {
    "gecko": {
      "id": "claude-code-bridge@llyfn.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["websiteContent", "browsingActivity"] }
    }
  },
  "permissions": ["nativeMessaging", "tabs", "tabGroups", "sessions", "<all_urls>", "webRequest", "webNavigation", "clipboardWrite"],
  "background": { "page": "background/background.html", "persistent": true },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start",
      "js": ["content/console-hook.js", "content/dialogs.js", "content/dom.js", "content/tree.js", "content/form.js", "content/text.js", "content/input.js", "content/router.js"]
    },
    {
      "matches": ["<all_urls>"],
      "run_at": "document_idle",
      "js": ["content/indicator.js"]
    }
  ]
}
